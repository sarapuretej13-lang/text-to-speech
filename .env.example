# -------------------------------------------------------
# Backend environment variables (copy to .env)
# -------------------------------------------------------

FLASK_ENV=development
FLASK_DEBUG=1

# Set this to your Vercel frontend URL in Render dashboard
# FRONTEND_URL=https://your-app.vercel.app

# If you upgrade from gTTS to a paid TTS provider, add keys here
# TTS_API_KEY=your_api_key
# TTS_REGION=your_region
# TTS_ENDPOINT=your_endpoint

# -------------------------------------------------------
# Frontend environment variables
# Set VITE_API_BASE_URL in Vercel dashboard under Environment Variables
# -------------------------------------------------------

# VITE_API_BASE_URL=https://your-tts-backend.onrender.com/api
